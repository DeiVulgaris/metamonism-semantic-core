{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mm:research_frontier:v1",
  "title": "Meta-Monism Research Frontier v1",
  "description": "Machine-readable representation of the current boundary of inquiry. Validates structure, not truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "frontier_id",
    "research_program_id",
    "trajectory_id",
    "frontier_state",
    "subject",
    "unresolved_difference",
    "provenance",
    "admissible_transitions"
  ],
  "properties": {
    "frontier_id": {
      "type": "string",
      "minLength": 1
    },
    "research_program_id": {
      "type": "string",
      "minLength": 1
    },
    "trajectory_id": {
      "type": "string",
      "minLength": 1
    },
    "frontier_state": {
      "type": "string",
      "enum": [
        "ESTABLISHED",
        "PARTIALLY_RESOLVED",
        "UNRESOLVED",
        "BLOCKED",
        "CONFLICTING",
        "UNTESTED",
        "NEWLY_GENERATED"
      ]
    },
    "epistemic_status": {
      "type": "string",
      "enum": [
        "SOURCE",
        "INFERENCE",
        "FORMALIZATION",
        "THEORETICAL_HYPOTHESIS",
        "PROPOSAL",
        "UNRESOLVED",
        "CONFLICT",
        "USED_BUT_UNDEFINED",
        "PRIOR_THEORETICAL_FORMULATION",
        "MODEL_SPECIFIC"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        }
      }
    },
    "unresolved_difference": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "ref",
        "locator"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "type": "string"
        }
      }
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "admissible_transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "status",
          "prerequisites"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "DEFINE",
              "FORMALIZE",
              "TEST",
              "COMPARE",
              "DERIVE",
              "COUNTEREXAMPLE",
              "REPLICATE",
              "BRANCH",
              "COMPOSE",
              "DELEGATE",
              "REFRAME",
              "TERMINATE"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "CONDITIONAL",
              "BLOCKED",
              "PROHIBITED"
            ]
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relation_type",
          "target"
        ],
        "properties": {
          "relation_type": {
            "type": "string",
            "enum": [
              "IDENTITY",
              "EQUIVALENT_FORMULATION",
              "STRUCTURAL_CORRESPONDENCE",
              "EXTENSION",
              "SPECIALIZATION",
              "GENERALIZATION",
              "UNRESOLVED",
              "CONFLICT"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string"
          },
          "derived_from": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}