{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Deivulgaris/metamonism-semantic-core/blob/main/stage63_research_loop_r1/uql_schemas.json",
  "title": "UQL-compatible Research Loop R1 schemas",
  "description": "Minimal durable question/branch/history/frontier contracts for R1. Persistence and transition rules are implemented separately.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$defs"],
  "properties": {
    "$defs": {"type": "object"}
  },
  "$defs": {
    "uql_question": {
      "title": "UQL Question",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uql_question_id",
        "status",
        "branch_id",
        "root_question_id",
        "question",
        "unresolved_difference",
        "constraints",
        "provenance"
      ],
      "properties": {
        "uql_question_id": {"type": "string", "minLength": 1},
        "status": {
          "type": "string",
          "enum": ["OPEN", "CLOSED"]
        },
        "branch_id": {"type": "string", "minLength": 1},
        "root_question_id": {"type": "string", "minLength": 1},
        "parent_question_id": {"type": ["string", "null"]},
        "question": {"type": "string", "minLength": 1},
        "unresolved_difference": {"type": "string", "minLength": 1},
        "constraints": {
          "type": "array",
          "items": {"type": "string"}
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },

    "branch": {
      "title": "UQL Branch",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch_id",
        "root_question_id",
        "parent_branch_id",
        "origin_step_id",
        "origin_trigger",
        "tip_question_id",
        "status",
        "lineage"
      ],
      "properties": {
        "branch_id": {"type": "string", "minLength": 1},
        "root_question_id": {"type": "string", "minLength": 1},
        "parent_branch_id": {"type": ["string", "null"]},
        "origin_step_id": {"type": ["string", "null"]},
        "origin_trigger": {"type": ["string", "null"]},
        "tip_question_id": {"type": ["string", "null"]},
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "CLOSED"]
        },
        "lineage": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },

    "history_entry": {
      "title": "Append-only UQL History Entry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "occurred_on",
        "uql_question_id",
        "branch_id"
      ],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "event_type": {"type": "string", "minLength": 1},
        "occurred_on": {"type": "string", "minLength": 1},
        "uql_question_id": {"type": "string", "minLength": 1},
        "branch_id": {"type": "string", "minLength": 1},
        "payload": {
          "type": "object",
          "additionalProperties": true
        },
        "previous_event_id": {"type": ["string", "null"]},
        "sequence": {
          "type": "integer",
          "minimum": 0
        }
      }
    },

    "frontier_index": {
      "title": "UQL Frontier Index",
      "type": "object",
      "additionalProperties": false,
      "required": ["active_branch_ids", "active_tip_question_ids"],
      "properties": {
        "active_branch_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "active_tip_question_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },

    "provenance": {
      "title": "R1 Provenance",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ontology_write",
        "claim_elevate"
      ],
      "properties": {
        "parent_question": {"type": ["string", "null"]},
        "derived_from_step": {"type": ["string", "null"]},
        "trigger": {"type": ["string", "null"]},
        "derivation_basis": {"type": "string", "minLength": 1},
        "source": {"type": ["string", "null"]},
        "ontology_write": {"const": false},
        "claim_elevate": {"const": false}
      }
    },

    "policy_decision_minimal": {
      "title": "Minimal R0 Policy Decision accepted by R1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "selected_operation",
        "rationale_codes",
        "derived_question"
      ],
      "properties": {
        "question_id": {"type": "string", "minLength": 1},
        "selected_operation": {
          "type": "string",
          "enum": [
            "diff",
            "fix",
            "diss",
            "unfold",
            "delegate",
            "compose",
            "terminate"
          ]
        },
        "rationale_codes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "derived_question": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": [
                "question_id",
                "parent_question",
                "derived_from_step",
                "trigger",
                "unresolved_difference",
                "derivation_basis",
                "constraints",
                "status"
              ],
              "additionalProperties": true,
              "properties": {
                "question_id": {"type": "string", "minLength": 1},
                "parent_question": {"type": "string", "minLength": 1},
                "derived_from_step": {"type": "string", "minLength": 1},
                "trigger": {"type": "string", "minLength": 1},
                "unresolved_difference": {"type": "string", "minLength": 1},
                "derivation_basis": {"type": "string", "minLength": 1},
                "constraints": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "status": {"const": "OPEN"}
              }
            }
          ]
        }
      }
    }
  }
}
