{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Deivulgaris/metamonism-semantic-core/blob/main/stage60/reasoning_trace.schema.json",
  "title":"Invariant Rooted Reasoning Replay Trace v1",
  "type":"object",
  "additionalProperties":false,
  "required":["trace_id","root_invariant","chain_path","steps","information_result","consequence","next_action","provenance"],
  "properties":{
    "trace_id":{"type":"string","minLength":1},
    "root_invariant":{"type":"object","additionalProperties":true},
    "chain_path":{"type":"array","minItems":2,"items":{"type":"string","minLength":1}},
    "steps":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":true}},
    "information_result":{"type":"object","additionalProperties":true},
    "consequence":{"type":"string","minLength":1},
    "next_action":{"type":"string","minLength":1},
    "provenance":{"type":"object","additionalProperties":true}
  }
}
