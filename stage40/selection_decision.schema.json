{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"mm:research_selection_decision:v1",
  "title":"Meta-Monism Research Selection Decision v1",
  "type":"object",
  "additionalProperties":false,
  "required":["decision_id","policy","candidate_task_ids","selected_task_ids","status","criteria","rationale","provenance"],
  "properties":{
    "decision_id":{"type":"string","minLength":1},
    "policy":{"type":"string","enum":["USER_SELECTED","DEPENDENCY_FIRST","BLOCKER_FIRST","CHEAPEST_TEST_FIRST","INFORMATION_GAIN","PARALLEL_BRANCHING"]},
    "candidate_task_ids":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "selected_task_ids":{"type":"array","items":{"type":"string","minLength":1}},
    "status":{"type":"string","enum":["SELECTED","BLOCKED","NO_ELIGIBLE_TASK","INVALID_REQUEST"]},
    "criteria":{"type":"array","items":{"type":"string","minLength":1}},
    "rationale":{"type":"string","minLength":1},
    "metrics_used":{"type":"object"},
    "user_selected_task_id":{"type":"string"},
    "provenance":{"type":"object","required":["repository","path","ref","locator"],"additionalProperties":false,"properties":{"repository":{"type":"string","minLength":1},"path":{"type":"string","minLength":1},"ref":{"type":"string","minLength":1},"locator":{"type":"string","minLength":1},"excerpt":{"type":"string"}}},
    "selection_notes":{"type":"array","items":{"type":"string","minLength":1}}
  }
}