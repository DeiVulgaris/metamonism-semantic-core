{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Deivulgaris/metamonism-semantic-core/blob/main/stage61/impact_localized_frontier.schema.json",
  "title":"Impact Localized Frontier v1",
  "type":"object",
  "additionalProperties":false,
  "required":["frontier_id","question_id","root_invariant_id","trace_id","anchor_step_id","impact_mode","reasoning_prefix","affected_step","downstream_steps","next_required_operation","provenance"],
  "properties":{
    "frontier_id":{"type":"string","minLength":1},
    "question_id":{"type":"string","minLength":1},
    "root_invariant_id":{"type":"string","minLength":1},
    "trace_id":{"type":"string","minLength":1},
    "anchor_step_id":{"type":"string","minLength":1},
    "impact_mode":{"type":"string","enum":["EXPLICIT_STEP_REFERENCE","TAIL_FALLBACK"]},
    "reasoning_prefix":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "affected_step":{"type":"object","additionalProperties":true},
    "downstream_steps":{"type":"array","items":{"type":"object","additionalProperties":true}},
    "next_required_operation":{"type":"string","minLength":1},
    "provenance":{"type":"object","additionalProperties":true}
  }
}
