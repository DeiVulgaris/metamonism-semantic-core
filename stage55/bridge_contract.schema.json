{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Deivulgaris/metamonism-semantic-core/blob/main/stage55/bridge_contract.schema.json",
  "title":"Meta-Monism Core to UFCPS Task Formation Bridge",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "bridge_id",
    "source_frontier",
    "question",
    "unresolved_difference",
    "constraints",
    "evidence_refs",
    "failed_paths",
    "next_required_operation",
    "task_formation_status",
    "provenance"
  ],
  "properties":{
    "bridge_id":{"type":"string","minLength":1},
    "source_frontier":{
      "type":"object",
      "additionalProperties":false,
      "required":["frontier_id","state","epistemic_status"],
      "properties":{
        "frontier_id":{"type":"string","minLength":1},
        "state":{"type":"string","minLength":1},
        "epistemic_status":{"type":"string","minLength":1}
      }
    },
    "question":{"type":"string","minLength":1},
    "unresolved_difference":{"type":"string","minLength":1},
    "constraints":{
      "type":"array",
      "items":{"type":"string","minLength":1}
    },
    "evidence_refs":{
      "type":"array",
      "items":{"type":"string","minLength":1}
    },
    "failed_paths":{
      "type":"array",
      "items":{"type":"string","minLength":1}
    },
    "next_required_operation":{
      "type":"string",
      "enum":[
        "diff","fix","diss","unfold",
        "delegate","compose","investigate",
        "experiment","formalize","validate",
        "request_resources","terminate"
      ]
    },
    "task_formation_status":{
      "type":"string",
      "enum":[
        "CANDIDATE",
        "READY",
        "BLOCKED",
        "UNRESOLVED",
        "INVALID"
      ]
    },
    "provenance":{
      "type":"object",
      "additionalProperties":false,
      "required":["source_repository","source_reference","derivation_mode"],
      "properties":{
        "source_repository":{"type":"string","minLength":1},
        "source_reference":{"type":"string","minLength":1},
        "derivation_mode":{
          "type":"string",
          "enum":["SOURCE_REFERENCE","INFERENCE","FORMALIZATION","PROPOSAL"]
        }
      }
    },
    "new_data":{
      "type":"array",
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["data_id","description","provenance","semantic_status"],
        "properties":{
          "data_id":{"type":"string","minLength":1},
          "description":{"type":"string","minLength":1},
          "provenance":{"type":"string","minLength":1},
          "semantic_status":{"type":"string","minLength":1}
        }
      }
    }
  }
}
