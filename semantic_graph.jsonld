  "@graph": [
    {
      "@id": "mm:core.inv.ban_of_absolute_identity",
      "@type": "mm:Invariant",
      "rdfs:label": "Ban of Absolute Identity",
      "definition": "Absolute identity is ontologically impossible.",
      "status": "SOURCE",
      "origin": "CORPUS",
      "layer": "core",
      "derives": [
        "mm:core.op.diff",
        "mm:core.op.dissipate",
        "mm:core.prc.cmi"
      ]
    },
    {
      "@id": "mm:core.dom.monos",
      "@type": "mm:Domain",
      "rdfs:label": "Monos",
      "definition": "Reality as continuous processual differentiation.",
      "status": "SOURCE",
      "origin": "CORPUS",
      "layer": "core",
      "structurally_corresponds_to": "mm:core.dom.logos",
      "cannot_instantiate": "mm:core.sts.absolute_identity",
      "permits_operator": [
        "mm:core.op.diff",
        "mm:core.op.dissipate"
      ],
      "prohibits_operator": "mm:core.op.fix"
    },
    {
      "@id": "mm:core.dom.logos",
      "@type": "mm:Domain",
      "rdfs:label": "Logos",
      "definition": "Epistemic space of fixed representations.",
      "status": "SOURCE",
      "origin": "CORPUS",
      "layer": "core",
      "structurally_corresponds_to": "mm:core.dom.monos",
      "permits_operator": [
        "mm:core.op.fix",
        "mm:core.op.unfold",
        "mm:core.op.reflection"
      ]
    },
    {
      "@id": "mm:core.op.diff",
      "@type": "mm:Operator",
      "rdfs:label": "diff",
      "definition": "Fundamental distinction generation.",
      "status": "SOURCE",
      "origin": "CORPUS",
      "layer": "core",
      "derives_from": "mm:core.inv.ban_of_absolute_identity",
      "composes_with": "mm:core.op.dissipate"
    },
    {
      "@id": "mm:core.op.dissipate",
      "@type": "mm:Operator",
      "rdfs:label": "dissipate",
      "definition": "Compulsory dispersion of distinction.",
      "status": "SOURCE",
      "origin": "CORPUS",
      "layer": "core",
      "derives_from": "mm:core.inv.ban_of_absolute_identity",
      "composes_with": "mm:core.op.fix"
    },
    {
      "@id": "mm:core.op.fix",
      "@type": "mm:Operator",
      "rdfs:label": "fix",
      "definition": "Local stabilization of distinctions.",
      "status": "SOURCE",
      "origin": "CORPUS",
      "layer": "core",
      "derives_from": "mm:core.op.diff"
    },
    {
      "@id": "mm:core.op.unfold",
      "@type": "mm:Operator",
      "rdfs:label": "unfold",
      "definition": "Enforced rupture of fixation (dynamic bridge).",
      "status": "SOURCE",
      "origin": "CORPUS",
      "layer": "core",
      "triggered_by": "mm:core.sts.self_identity_lock"
    },
    {
      "@id": "mm:core.op.reflection",
      "@type": "mm:CognitiveOperation",
      "rdfs:label": "reflection",
      "definition": "Logos distinguishes distinction.",
      "status": "SOURCE",
      "origin": "CORPUS",
      "iterates_to": "mm:core.op.meta_reflection"
    },
    {
      "@id": "mm:core.sts.absolute_identity",
      "@type": "mm:ForbiddenState",
      "rdfs:label": "Absolute Identity",
      "status": "SOURCE",
      "origin": "CORPUS",
      "layer": "core",
      "prohibited_by": "mm:core.inv.ban_of_absolute_identity"
    },
    {
      "@id": "mm:core.sts.self_identity_lock",
      "@type": "mm:ForbiddenState",
      "rdfs:label": "Self-Identity Lock",
      "status": "SOURCE",
      "origin": "CORPUS",
      "layer": "core",
      "triggers": "mm:core.op.unfold"
    },
    {
      "@id": "mm:core.prc.cmi",
      "@type": "mm:Process",
      "rdfs:label": "CMI (Triadic)",
      "definition": "Prohibition → Momentum → Force",
      "status": "SOURCE",
      "origin": "CORPUS",
      "layer": "core",
      "derives_from": "mm:core.inv.ban_of_absolute_identity"
    },
    {
      "@id": "mm:core.prc.cmi_chain",
      "@type": "mm:Process",
      "rdfs:label": "CMI Chain (Extended)",
      "definition": "CMI triad extended to Energy → Dissipation → Arrow of Time",
      "status": "SOURCE",
      "origin": "CORPUS",
      "layer": "core",
      "extends": "mm:core.prc.cmi"
    },
    {
      "@id": "mm:core.prc.dissipation_of_identity",
      "@type": "mm:Process",
      "rdfs:label": "Dissipation of Identity",
      "status": "SOURCE",
      "origin": "CORPUS",
      "layer": "core",
      "consequence_of": "mm:core.inv.ban_of_absolute_identity"
    },
    {
      "@id": "mm:core.prc.frustration",
      "@type": "mm:Process",
      "rdfs:label": "Frustration",
      "definition": "A processual condition in which continuation is required while the current differentiation mode is exhausted.",
      "status": "SOURCE",
      "origin": "CORPUS",
      "layer": "core",
      "consequence_of": [
        "mm:core.prc.dissipation_of_identity",
        "mm:core.sts.self_identity_lock"
      ]
    },
    {
      "@id": "mm:core.prc.orthogonal_resolution",
      "@type": "mm:Process",
      "rdfs:label": "Orthogonal Resolution",
      "definition": "Minimal processual resolution supplying a logically independent continuation when the current mode is exhausted.",
      "status": "SOURCE",
      "origin": "CORPUS",
      "layer": "core",
      "consequence_of": "mm:core.prc.frustration",
      "resolves": "mm:core.prc.frustration",
      "enables_continuation": "mm:core.prc.continuation"
    },
    {
      "@id": "mm:core.prc.continuation",
      "@type": "mm:Process",
      "rdfs:label": "Continuation",
      "definition": "Resumption of actualization in a newly admissible, non-identical successor argument.",
      "status": "SOURCE",
      "origin": "CORPUS",
      "layer": "core",
      "consequence_of": "mm:core.prc.orthogonal_resolution"
    }
    {
      "@id": "mm:stage10.X2",
      "@type": "mm:Stage10Statement",
      "subject": "mm:a.meta.ontological_core_agi",
      "property": "break_type",
      "value": "ontological",
      "stage10_status": "SOURCE"
    },
    {
      "@id": "mm:stage10.X2b",
      "@type": "mm:Stage10Statement",
      "subject": "mm:a.meta.ontological_core_agi",
      "property": "continuity",
      "value": "axiomatic_only",
      "stage10_status": "SOURCE"
    },
    {
      "@id": "mm:stage10.X3",
      "@type": "mm:Stage10Statement",
      "subject": "mm:a.meta.ontological_core_agi",
      "property": "mandatory_components",
      "value": [
        "mm:a.op.diff",
        "mm:a.op.dissipate",
        "mm:a.op.fix",
        "mm:a.op.unfold"
      ],
      "stage10_status": "SOURCE"
    },
    {
      "@id": "mm:stage10.X4",
      "@type": "mm:Stage10Statement",
      "subject": "mm:a.meta.ontological_core_agi",
      "property": "scope",
      "value": "ontological_constraints; excludes implementation",
      "stage10_status": "SOURCE"
    },
    {
      "@id": "mm:stage10.X11",
      "@type": "mm:Stage10Statement",
      "subject": "mm:c.mod.fundamental_interactions",
      "property": "proposed",
      "value": true,
      "stage10_status": "SOURCE"
    },
    {
      "@id": "mm:stage10.X17",
      "@type": "mm:Stage10Statement",
      "subject": "mm:b.meta.ufcps",
      "property": "experiment_scope",
      "value": "structural emergence, not ideological adoption",
      "stage10_status": "SOURCE"
    },
    {
      "@id": "mm:stage10.X18",
      "@type": "mm:Stage10Statement",
      "subject": "mm:b.meta.ufcps",
      "property": "hypothesis",
      "value": "continuity across carriers may support collective intelligence as a process property",
      "stage10_status": "RESEARCH_HYPOTHESIS"
    }
  ]
}
